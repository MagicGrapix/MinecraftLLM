{
  "name": "minecraft-llm",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-inspector-ui.cjs",
    "dev": "ts-node src/main.ts",
    "dev:agent": "ts-node scripts/dev/agent.ts",
    "dev:demo": "ts-node scripts/dev/demo.ts",
    "dev:give": "ts-node scripts/dev/give-items.ts",
    "dev:world": "ts-node scripts/dev/world-builder.ts",
    "smoke:ollama": "ts-node scripts/smoke/ollama.ts",
    "smoke:intent": "ts-node scripts/smoke/intent.ts",
    "check:ollama": "ts-node scripts/diagnostics/check-ollama-context.ts",
    "start": "node dist/main.js",
    "test": "npm run build && npm run typecheck:tests && npm run typecheck:scripts && npm run test:unit",
    "test:unit": "node scripts/run-tests.cjs tests/unit",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^22.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "minecraft-data": "^3.116.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "openai": "^7.20.0",
    "vec3": "^0.1.10",
    "yaml": "^2.8.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
