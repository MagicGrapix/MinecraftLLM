LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=medium
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_TOOL_ROUNDS=8
LLM_CONTEXT_BUDGET_CHARS=30000
OLLAMA_EXPECTED_CONTEXT_LENGTH=32768
BOT_OWNER_USERNAME=GrapixMagique
BOT_MODE=agent
LANDMARKS_FILE=./data/landmarks.json
PROMPTS_DIR=./prompts
LOG_DIR=./logs
LOG_FULL_TRACE=false

# Local read-only LLM context inspector (agent mode only)
AGENT_INSPECTOR_ENABLED=true
AGENT_INSPECTOR_HOST=127.0.0.1
AGENT_INSPECTOR_PORT=3001
AGENT_INSPECTOR_MAX_ROUNDS=30

# Shared local Minecraft server
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.11
MINECRAFT_USERNAME=bot

# Independent OP development world controller
# Run once in the server console: op world_controller
WORLD_CONTROLLER_USERNAME=world_controller
WORLD_AGENT_USERNAME=bot
# Vanilla 1.21.11 disconnects Mineflayer command senders above 1/s as spam.
WORLD_COMMANDS_PER_SECOND=1
WORLD_COMMAND_RESPONSE_WINDOW_MS=150
WORLD_MAX_QUEUE_SIZE=1000
WORLD_MAX_PLAN_COMMANDS=256
WORLD_MAX_FILL_BLOCKS=32768
WORLD_ARENA_MIN_X=-48
WORLD_ARENA_MAX_X=48
WORLD_ARENA_MIN_Y=-96
WORLD_ARENA_MAX_Y=-30
WORLD_ARENA_MIN_Z=-48
WORLD_ARENA_MAX_Z=48
WORLD_SURFACE_Y=-61
WORLD_MAX_TREES=32
WORLD_MAX_FOREST_RADIUS=40
WORLD_MAX_VEIN_SIZE=64
WORLD_TREE_FEATURE=minecraft:oak
